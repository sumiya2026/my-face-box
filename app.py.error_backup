from flask import Flask, render_template, request, jsonify
import os, json, uuid
from datetime import datetime
app = Flask(__name__)
os.makedirs('static/uploads', exist_ok=True)
if os.path.exists('pages.json'):
    try:
        with open('pages.json','r') as f: PAGES=json.load(f)
    except: PAGES=[]
else: PAGES=[]

@app.route('/')
def home(): return render_template('index.html')
@app.route('/api/pages')
def api_pages(): return jsonify(PAGES)
@app.route('/api/page/create', methods=['POST'])
def api_create():
    name=request.form.get('name','').strip()
    if not name: return jsonify(status='error', msg='Name ඕන!')
    img=""
    if 'file' in request.files:
        f=request.files['file']
        if f and f.filename:
            fn=f"{uuid.uuid4().hex}_{f.filename}"
            f.save(os.path.join('static/uploads', fn))
            img=f"/static/uploads/{fn}"
    page={"id":uuid.uuid4().hex[:6],"name":name,"category":request.form.get('category',''),"bio":request.form.get('bio',''),"image":img}
    PAGES.append(page)
    with open('pages.json','w') as jf: json.dump(PAGES,jf)
    return jsonify(status='ok', page=page)

if __name__=='__main__': app.run(host='0.0.0.0', port=8000, debug=True)
