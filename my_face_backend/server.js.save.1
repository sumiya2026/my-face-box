app.get('/api/posts', (req, res) => {
    const db = readDB();
    res.status(200).json({ status: "Success", posts: db.posts.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)) });
});

app.post('/api/posts/create', (req, res) => {
    const { content, imageUrl } = req.body;
    const db = readDB();
    const newPost = { id: 'post_' + Date.now(), content, imageUrl: imageUrl || "", likes: 0, comments: [], createdAt: new Date() };
    db.posts.push(newPost);
    writeDB(db);
    res.status(201).json({ status: "Success" });
});

app.post('/api/posts/like', (req, res) => {
    const { postId } = req.body;
    const db = readDB();
    const post = db.posts.find(p => p.id === postId);
    if(post) { post.likes = post.likes === 0 ? 1 : 0; writeDB(db); }
    res.status(200).json({ status: "Success" });
});

app.post('/api/posts/comment', (req, res) => {
    const { postId, comment } = req.body;
    const db = readDB();
    const post = db.posts.find(p => p.id === postId);
    if(post) { if(!post.comments) post.comments = []; post.comments.push(comment); writeDB(db); }
    res.status(200).json({ status: "Success" });
});

